Upstream:      upower (gitlab.freedesktop.org/upower/upower):
               src/linux/up-device-supply-battery.c
Upstreamable:  yes, behind a quirk flag rather than unconditionally
How:           A merge request on freedesktop GitLab; search its issues for
               Framework 13 AMD zero readings first. Upstream would likely want
               the filter enabled by a hwdb/udev property for affected machines.
Written:       2026-05-11, against upower 1.91.1
Last checked:  2026-10-25: 1.91.5 has no such filter
Remove when:   upower filters these readings itself, or no host has a battery
               that produces them
Applied by:    modules/desktop/upower-overlay.nix

Some embedded controllers (seen on a Framework 13 AMD) report charge_now and
capacity as 0 for a single polling cycle. upower passes that through, and the
desktop fires a "battery critical" warning. The patch drops a near-zero reading
that follows a healthy one, and accepts it on the next cycle if the kernel
still reports 0.

--- a/src/linux/up-device-supply-battery.c
+++ b/src/linux/up-device-supply-battery.c
@@ -76,6 +76,8 @@
 	gboolean		 shown_invalid_voltage_warning;
 	gboolean		 ignore_system_percentage;
 	gboolean		 support_charge_limit;
+	gdouble			 last_good_percentage;
+	gboolean		 saw_spurious_zero;
 };
 
 G_DEFINE_TYPE (UpDeviceSupplyBattery, up_device_supply_battery, UP_TYPE_DEVICE_BATTERY)
@@ -545,6 +547,25 @@
 
 	values.temperature = g_udev_device_get_sysfs_attr_as_double_uncached (native, "temp") / 10.0;
 
+	/* QUIRK: Some embedded controllers (e.g. Framework 13 AMD) momentarily
+	 * report charge_now/capacity as 0 for a single polling cycle. Suppress
+	 * the report if we suddenly see ~0 after a healthy reading; accept it
+	 * the next cycle if the kernel is still reporting 0 (i.e. real). */
+	if ((values.percentage < 0.5 || values.energy.cur < 0.01) &&
+	    self->last_good_percentage > 5.0 &&
+	    !self->saw_spurious_zero) {
+		g_warning ("ignoring spurious zero battery reading "
+			   "(percentage=%.2f energy_cur=%.4f, last good=%.1f%%)",
+			   values.percentage, values.energy.cur,
+			   self->last_good_percentage);
+		self->saw_spurious_zero = TRUE;
+		return TRUE;
+	}
+	if (values.percentage > 0.5 && values.energy.cur > 0.01) {
+		self->last_good_percentage = values.percentage;
+		self->saw_spurious_zero = FALSE;
+	}
+
 	up_device_battery_report (battery, &values, reason);
 
 	return TRUE;
