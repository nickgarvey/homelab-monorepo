+/// The labels of the Sandbox resource's pod template: the sandbox template's
+/// labels and the workload boundary labels.
+fn sandbox_pod_template_labels(object: &DynamicObject) -> BTreeMap<String, String> {
+    object
+        .data
+        .pointer("/spec/podTemplate/metadata/labels")
+        .and_then(serde_json::Value::as_object)
+        .into_iter()
+        .flatten()
+        .filter_map(|(key, value)| Some((key.clone(), value.as_str()?.to_string())))
+        .collect()
+}
