+/// The supervisor Pod's labels: the sandbox template's labels, which the
+/// workload Pod also carries, so that selectors keyed on them (workload
+/// identity, policy, monitoring) can match the supervisor too; then the
+/// driver's own control labels. Template labels in the `openshell.ai`
+/// namespace are dropped, and none can replace a control label.
+fn supervisor_labels(
+    sandbox_id: &str,
+    gateway_id: &str,
+    template_labels: &BTreeMap<String, String>,
+) -> BTreeMap<String, String> {
+    let mut labels: BTreeMap<String, String> = template_labels
+        .iter()
+        .filter(|(key, _)| !is_openshell_label(key))
+        .map(|(key, value)| (key.clone(), value.clone()))
+        .collect();
+    labels.extend(control_labels(sandbox_id, gateway_id));
+    labels
+}
+
+/// Whether a label key's prefix is `openshell.ai` or one of its subdomains.
+fn is_openshell_label(key: &str) -> bool {
+    key.split_once('/').is_some_and(|(prefix, _)| {
+        prefix == "openshell.ai" || prefix.ends_with(".openshell.ai")
+    })
+}
