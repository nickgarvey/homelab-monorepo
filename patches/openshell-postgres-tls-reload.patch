+
+#[tokio::test(start_paused = true)]
+async fn plain_pool_reparses_its_url_once_per_interval() {
+    let url = "postgres://openshell@localhost/openshell?sslmode=verify-full&sslcert=/nonexistent/tls.crt&sslkey=/nonexistent/tls.key";
+    let inner = PgPoolOptions::new().connect_lazy(url).unwrap();
+    let pool = CredentialPool::reloading_every(inner, url, Duration::from_secs(60));
+    let initial = pool.inner.connect_options();
+
+    pool.reload_tls();
+    assert!(
+        Arc::ptr_eq(&initial, &pool.inner.connect_options()),
+        "reparsed before the interval"
+    );
+
+    tokio::time::advance(Duration::from_secs(61)).await;
+    pool.reload_tls();
+    let reloaded = pool.inner.connect_options();
+    assert!(!Arc::ptr_eq(&initial, &reloaded), "not reparsed after the interval");
+
+    pool.reload_tls();
+    assert!(
+        Arc::ptr_eq(&reloaded, &pool.inner.connect_options()),
+        "reparsed twice within one interval"
+    );
+}
+
+#[tokio::test]
+async fn unparseable_url_keeps_the_current_options() {
+    let url = "postgres://openshell@localhost/openshell";
+    let inner = PgPoolOptions::new().connect_lazy(url).unwrap();
+    let pool = CredentialPool::reloading_every(inner, "not a url", Duration::ZERO);
+    let initial = pool.inner.connect_options();
+    pool.reload_tls();
+    assert!(Arc::ptr_eq(&initial, &pool.inner.connect_options()));
+}
