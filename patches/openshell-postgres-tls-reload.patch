 impl CredentialPool {
+    /// A plain pool built from `url`, which it reparses every
+    /// [`TLS_RELOAD_INTERVAL`] so that renewed TLS files take effect.
+    pub(super) fn reloading(inner: PgPool, url: &str) -> Self {
+        Self::reloading_every(inner, url, TLS_RELOAD_INTERVAL)
+    }
+
+    fn reloading_every(inner: PgPool, url: &str, interval: Duration) -> Self {
+        Self {
+            inner,
+            identity: None,
+            tls_reload: Some(Arc::new(TlsReload {
+                url: url.to_owned(),
+                interval,
+                next: std::sync::Mutex::new(Instant::now() + interval),
+            })),
+        }
+    }
+
+    /// Once the interval has passed, installs connect options freshly parsed
+    /// from the URL, whose TLS connector is built (and the files read) on the
+    /// next connection attempt. Open connections are left as they are.
+    fn reload_tls(&self) {
+        let Some(reload) = &self.tls_reload else {
+            return;
+        };
+        let now = Instant::now();
+        {
+            // A concurrent caller is already reloading.
+            let Ok(mut next) = reload.next.try_lock() else {
+                return;
+            };
+            if now < *next {
+                return;
+            }
+            *next = now + reload.interval;
+        }
+        match reload.url.parse::<PgConnectOptions>() {
+            Ok(options) => self.inner.set_connect_options(options),
+            Err(error) => tracing::warn!(
+                %error,
+                "reparsing the database URL failed; keeping the current connect options"
+            ),
+        }
+    }
