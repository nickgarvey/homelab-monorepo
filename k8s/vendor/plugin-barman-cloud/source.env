# Fetched into manifest.yaml by scripts/fetch-vendor.sh. The Barman Cloud plugin
# is how CNPG backs up to S3 (Garage) now that the in-tree barmanObjectStore is
# deprecated. It installs into cnpg-system next to the operator and needs
# cert-manager for its mTLS certificates.
VERSION=v0.15.1
URL=https://github.com/cloudnative-pg/plugin-barman-cloud/releases/download/$VERSION/manifest.yaml
OUT=manifest.yaml
