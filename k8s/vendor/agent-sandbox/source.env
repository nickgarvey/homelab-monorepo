# Fetched into sandbox.yaml by scripts/fetch-vendor.sh. Core Sandbox CRD and
# controller only: OpenShell's kubernetes driver creates Sandbox objects and
# does not use the extensions (SandboxTemplate/SandboxClaim). v1.0.3 is the
# version OpenShell 0.1.2's e2e suite installs.
VERSION=v1.0.3
URL=https://github.com/kubernetes-sigs/agent-sandbox/releases/download/$VERSION/sandbox.yaml
OUT=sandbox.yaml
